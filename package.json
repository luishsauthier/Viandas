{
  "name": "controle-de-viandas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build && node scripts/spa-404.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test:phone": "npx tsx tests/phone.test.ts",
    "test:dates": "npx tsx tests/dates.test.ts",
    "test:whatsapp": "npx tsx tests/whatsapp.test.ts",
    "test:orders": "npx tsx tests/orders.test.ts",
    "test:restaurant": "npx tsx tests/restaurantOrder.test.ts",
    "test:charge": "npx tsx tests/chargeMessage.test.ts",
    "test:pix": "npx tsx tests/pix.test.ts",
    "test:pix-description": "npx tsx tests/pixDescription.test.ts",
    "test:fifo": "npx tsx tests/fifo.test.ts",
    "test:map-extraction": "npx tsx tests/mapExtraction.test.ts",
    "test:menu-presets": "npx tsx tests/menuPresets.test.ts",
    "test:all": "npm run test:phone && npm run test:dates && npm run test:whatsapp && npm run test:orders && npm run test:restaurant && npm run test:charge && npm run test:pix && npm run test:pix-description && npm run test:fifo && npm run test:map-extraction && npm run test:menu-presets",
    "verify": "npm run typecheck && npm run test:all && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@rive-app/react-canvas": "^4.32.1",
    "@supabase/supabase-js": "^2.112.3",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0"
  }
}
